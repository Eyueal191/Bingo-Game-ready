# ──────────────────────────────────────────────
# Server environment variables
# Copy to .env and fill in real values
# ──────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB (must match docker-compose credentials)
MONGOURL=mongodb://root:CHANGE_ME@haywin-mongo:27017/haywin?authSource=admin&replicaSet=rs0

# Authentication
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING

# CORS
FRONTEND_URL=http://localhost:5173

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=

# AddisPay (optional)
ADDISPAY_API_KEY=

# Payment redirects (optional)
SUCCESS_URL=
ERROR_URL=
