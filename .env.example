# ──────────────────────────────────────────────
# Root-level environment variables
# Used by docker-compose.yml for MongoDB init
# ──────────────────────────────────────────────

# MongoDB root credentials (used by the haywin-mongo service)
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
